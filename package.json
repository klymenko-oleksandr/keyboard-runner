{
  "name": "keyboard-runner",
  "version": "1.0.0",
  "description": "Real-time multiplayer typing race (Socket.io + Express + TypeScript). Binary Studio Academy HTTP/WS homework.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "tsx watch src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-timeout=10000 tests/*.test.ts",
    "books:prepare": "tsx scripts/prepare-books.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "bsa",
    "homework",
    "socket.io",
    "websockets"
  ],
  "author": "Oleksandr Klymenko",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.0",
    "lodash": "^4.18.1",
    "mongodb": "^6.22.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
