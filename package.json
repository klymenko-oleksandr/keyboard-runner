{
  "name": "keyboard-runner",
  "version": "1.0.0",
  "description": "Real-time multiplayer typing race (Socket.io + Express + TypeScript). Binary Studio Academy HTTP/WS homework.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx watch src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bsa",
    "homework",
    "socket.io",
    "websockets"
  ],
  "author": "Oleksandr Klymenko",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
